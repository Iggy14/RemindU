# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# Only the public anon/publishable key goes here, never the service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only secret for /api/ai/* (no VITE_ prefix, so it never reaches the browser).
# Free key: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Optional: override the Gemini model (default is set in src/ai/server/model.ts)
# AI_MODEL=

# Web Push. Generate a pair with: npx web-push generate-vapid-keys
# The public key is safe in the browser; the private key is server-only (Vercel env).
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=
# Server-only (Vercel env, never VITE_): used by /api/send-reminders, which bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret pg_cron sends as "Authorization: Bearer ..." (see supabase/migrations/0004_push_cron.sql)
CRON_SECRET=
